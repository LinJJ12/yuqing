# 复制为 .env 后按需修改

# 情感模型（HuggingFace / 镜像，GPU）
# SENTIMENT_MODEL_ID=uer/roberta-base-finetuned-dianping-chinese
# SENTIMENT_NEUTRAL_THRESHOLD=0.62
# SENTIMENT_NEUTRAL_MARGIN=0.12
# DEVICE_PREFERENCE=cuda
# HF_ENDPOINT=https://hf-mirror.com

# 演示前预取情感模型（写入本机 HF 缓存）：
#   uv run python backend/scripts/prefetch_models.py

# 主题向量：默认本地 Ollama（你当前有 quentinz/bge-large-zh-v1.5）
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=quentinz/bge-large-zh-v1.5
# 若已拉取 bge-m3，改为：
# OLLAMA_EMBED_MODEL=bge-m3

# —— 云端 LLM（OpenAI 兼容：报告 AI 摘要 / Agent）——
# 未配置时回退本机 Ollama Chat（见下方 OLLAMA_CHAT_MODEL）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# 示例（任选其一，base_url / model 以各平台控制台为准）：
# 官方 OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# 火山引擎（方舟 / Ark）
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=ep-xxxxxxxx
#
# 阿里云百炼（DashScope 兼容模式）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
#
# DeepSeek（同样走 OpenAI 兼容）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Agent 回退：本机 Ollama 聊天模型
# OLLAMA_CHAT_MODEL=qwen2.5
